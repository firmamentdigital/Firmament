# Copie para .env (na mesma pasta do docker-compose.yml) e preencha.
# Nunca envie o .env para o GitHub.
# Depois de preencher: chown 1000:1000 .env && chmod 600 .env

# Endereço público do sistema (sem https://)
PUBLIC_HOST=silas10.wmorente.com.br

# Porta interna na VPS (a 8787 já está em uso na VPS da Hostinger)
PORT=8790

# E-mail do proprietário da gestão. Apenas um e-mail.
OWNER_EMAIL=organizador@exemplo.com.br

# Login master da gestão (usuário digitado na tela de acesso)
MASTER_LOGIN=organizador

# Senha do login master, já criptografada. Gere com:
#   docker compose run --rm --no-deps app node scripts/owner-password.mjs
# e cole aqui a linha que o comando imprimir.
MASTER_PASSWORD_HASH=
